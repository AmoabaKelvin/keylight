{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Keylight",
  "version": "0.3.2",
  "identifier": "com.kelvinamoaba.keylight",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:4322",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Keylight",
        "width": 1180,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 22 },
        "transparent": true,
        "windowEffects": { "effects": ["sidebar"], "state": "followsWindowActiveState" }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:4322"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Utility",
    "copyright": "Kelvin Amoaba",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2Mjc5NDQ4NUZGRjg3RDcKUldUWGgvOWZTSlFueGxQV2lQMXllcEZqVjcxOHAvT0VPd0pJc09QZFZucXNDSTdwYUhYNGtsV2gK",
      "endpoints": ["https://github.com/AmoabaKelvin/keylight/releases/latest/download/latest.json"],
      "requireSignedVersion": true
    }
  }
}
